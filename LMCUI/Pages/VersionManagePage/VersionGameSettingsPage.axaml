<pages:PageBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:pages="clr-namespace:LMCUI.Pages"
                xmlns:settings="clr-namespace:LMCUI.Controls.GameSettings"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                xmlns:i18n="clr-namespace:LMCUI.I18n"
                x:Class="LMCUI.Pages.VersionManagePage.VersionGameSettingsPage">
    <Grid Margin="60,20,40,30">
        <ScrollViewer>
            <StackPanel MaxWidth="1000" Spacing="1">
                <ui:FASettingsExpander Name="UseGlobalGameSettingsExpander"
                                       Header="{i18n:I18nBinding Key=Pages.VersionDetailPage.LaunchSettings.UseGlobal.Header}"
                                       Description="{i18n:I18nBinding Key=Pages.VersionDetailPage.LaunchSettings.UseGlobal.Description}"
                                       IconSource="Settings">
                    <ui:FASettingsExpander.Footer>
                        <ToggleSwitch Name="UseGlobalGameSettingsToggle"
                                      IsCheckedChanged="UseGlobalGameSettingsToggle_OnIsCheckedChanged"
                                      OffContent="{i18n:I18nBinding Key=Pages.VersionDetailPage.LaunchSettings.UseGlobal.Off}"
                                      OnContent="{i18n:I18nBinding Key=Pages.VersionDetailPage.LaunchSettings.UseGlobal.On}" />
                    </ui:FASettingsExpander.Footer>
                </ui:FASettingsExpander>
                <settings:GameSettingsEditor Name="SettingsEditor" IsVersionSettings="True"
                                             SettingsChanged="SettingsEditor_OnSettingsChanged" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</pages:PageBase>
