<pages:PageBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                xmlns:i18n="clr-namespace:LMCUI.I18n"
                xmlns:pages="clr-namespace:LMCUI.Pages"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="LMCUI.Pages.VersionManagePage.VersionManagePage">
    <Grid Margin="60,20,40,30" RowDefinitions="Auto,*" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
              ColumnSpacing="8" SizeChanged="TopBar_OnSizeChanged">
            <Button Name="CurrentRootButton" MinHeight="48" Padding="8,4"
                    Theme="{DynamicResource TransparentButton}"
                    HorizontalContentAlignment="Stretch"
                    ToolTip.Tip="{i18n:I18nBinding Key=Pages.VersionManagePage.CurrentRoot.OpenFolder}"
                    Click="CurrentRootButton_OnClick">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                    <ui:FASymbolIcon Symbol="OpenFolder" Width="20" Height="20"
                                     VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Name="CurrentRootHeaderText" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Name="CurrentRootDescriptionText"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>

            <ui:FACommandBar Name="ActionCommandBar" Grid.Column="1"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             DefaultLabelPosition="Right">
                <ui:FACommandBar.PrimaryCommands>
                    <ui:FACommandBarButton Label="{i18n:I18nBinding Key=Pages.VersionManagePage.CommandBar.InstallVersion}"
                                           Click="InstallVersionButton_OnClick">
                        <ui:FACommandBarButton.IconSource>
                            <ui:FASymbolIconSource Symbol="Download" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                    <ui:FACommandBarButton Label="{i18n:I18nBinding Key=Pages.VersionManagePage.CommandBar.SwitchMinecraftFolder}"
                                           Click="SwitchGameRootButton_OnClick">
                        <ui:FACommandBarButton.IconSource>
                            <ui:FASymbolIconSource Symbol="Switch" />
                        </ui:FACommandBarButton.IconSource>
                    </ui:FACommandBarButton>
                </ui:FACommandBar.PrimaryCommands>
            </ui:FACommandBar>
        </Grid>

        <Grid Grid.Row="1">
            <ContentControl Name="VersionListStateHost" />
            <ListBox Name="VersionListBox"
                     IsVisible="False"
                     BorderThickness="0"
                     Background="Transparent"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Grid>
    </Grid>
</pages:PageBase>
