<pages:PageBase xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i18n="clr-namespace:LMCUI.I18n"
             xmlns:pages="clr-namespace:LMCUI.Pages"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LMCUI.Pages.LaunchPage.LaunchPage">

    <Grid Margin="24">
        <Border
            MaxWidth="560"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Spacing="14">
                <TextBlock
                    Text="{i18n:I18nBinding Key=Pages.LaunchPage.WelcomeMessage}"
                    FontSize="24" />

                <TextBlock Text="临时启动测试面板" FontSize="14" Opacity="0.75" />

                <StackPanel Spacing="6">
                    <TextBlock Text="选择本地游戏版本" />
                    <ComboBox
                        Name="VersionComboBox"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="VersionComboBox_SelectionChanged" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="选择账户" />
                    <ComboBox
                        Name="AccountComboBox"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="AccountComboBox_SelectionChanged" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Name="CurrentStepLabel" Text="当前进行的启动步骤：未开始" />
                    <TextBlock Name="CurrentStatusLabel" Text="当前状态：等待选择版本和账户" TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Name="LaunchGameButton"
                    HorizontalAlignment="Left"
                    Content="启动游戏"
                    Click="LaunchGameButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</pages:PageBase>
