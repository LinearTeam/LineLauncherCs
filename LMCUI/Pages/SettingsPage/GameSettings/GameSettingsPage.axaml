<pages:PageBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:pages="clr-namespace:LMCUI.Pages"
                xmlns:settings="clr-namespace:LMCUI.Controls.GameSettings"
                x:Class="LMCUI.Pages.SettingsPage.GameSettings.GameSettingsPage">
    <Grid Margin="60,20,40,30">
        <ScrollViewer>
            <settings:GameSettingsEditor Name="SettingsEditor" SettingsChanged="SettingsEditor_OnSettingsChanged" />
        </ScrollViewer>
    </Grid>
</pages:PageBase>
