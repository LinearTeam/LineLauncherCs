<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="300"
             x:Class="LMCUI.Pages.DownloadMinecraftPage.DownloadMinecraft.DownloadMinecraftWizard">
    <!-- ContentDialog owns vertical scrolling for the whole wizard. -->
    <ui:FAFrame Name="contentFrm" IsVisible="False" HorizontalContentAlignment="Stretch" />
</UserControl>
